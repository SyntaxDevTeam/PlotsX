name: Build and publish plugin

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: read

env:
  MINI_PORTAL_URL: https://syntaxdevteam.pl
  BUILD_CHANNEL: dev
  BUILD_SLUG: plotsx
  BUILD_SERVER: Paper
  BUILD_GRADLE_TASK: build
  BUILD_GRADLE_PROPERTIES_TASK: properties
  BUILD_JAR_DIR: build/libs
  BUILD_ARTIFACT_PREFIX: PlotsX-

jobs:
  verify:
